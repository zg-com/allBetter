<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learningmplat.backend.mapper.BizCourseMapper">

    <resultMap id="BaseResultMap" type="com.learningmplat.backend.domain.BizCourse">
            <id property="id" column="id" />
            <result property="courseName" column="course_name" />
            <result property="credit" column="credit" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,course_name,credit,status,create_time
    </sql>
    <select id="selectCoursesByStudentId" resultType="com.learningmplat.backend.domain.BizCourse">
        SELECT
            c.* FROM
            biz_course c
                INNER JOIN
            biz_student_course sc ON c.id = sc.teaching_class_id
        WHERE
            sc.student_id = #{studentId}
    </select>
</mapper>
