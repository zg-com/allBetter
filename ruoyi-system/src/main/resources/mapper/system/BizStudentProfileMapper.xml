<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizStudentProfileMapper">
    
    <resultMap type="BizStudentProfile" id="BizStudentProfileResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="studentNo"    column="student_no"    />
        <result property="realName"    column="real_name"    />
        <result property="gender"    column="gender"    />
        <result property="idCard"    column="id_card"    />
        <result property="college"    column="college"    />
        <result property="major"    column="major"    />
        <result property="className"    column="class_name"    />
        <result property="enrollmentYear"    column="enrollment_year"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="statusProfile"    column="status_profile"    />
        <result property="cause"    column="cause"    />
    </resultMap>

    <sql id="selectBizStudentProfileVo">
        select id, user_id, student_no, real_name, gender, id_card, college, major, class_name, enrollment_year, status, create_by, create_time, update_by, update_time, remark, status_profile, cause from biz_student_profile
    </sql>

    <select id="selectBizStudentProfileList" parameterType="BizStudentProfile" resultMap="BizStudentProfileResult">
        <include refid="selectBizStudentProfileVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="studentNo != null  and studentNo != ''"> and student_no = #{studentNo}</if>
            <if test="realName != null  and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="gender != null  and gender != ''"> and gender = #{gender}</if>
            <if test="idCard != null  and idCard != ''"> and id_card = #{idCard}</if>
            <if test="college != null  and college != ''"> and college = #{college}</if>
            <if test="major != null  and major != ''"> and major = #{major}</if>
            <if test="className != null  and className != ''"> and class_name like concat('%', #{className}, '%')</if>
            <if test="enrollmentYear != null  and enrollmentYear != ''"> and enrollment_year = #{enrollmentYear}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="statusProfile != null "> and status_profile = #{statusProfile}</if>
            <if test="cause != null  and cause != ''"> and cause = #{cause}</if>
        </where>
    </select>
    
    <select id="selectBizStudentProfileById" parameterType="Long" resultMap="BizStudentProfileResult">
        <include refid="selectBizStudentProfileVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizStudentProfile" parameterType="BizStudentProfile" useGeneratedKeys="true" keyProperty="id">
        insert into biz_student_profile
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="studentNo != null and studentNo != ''">student_no,</if>
            <if test="realName != null and realName != ''">real_name,</if>
            <if test="gender != null">gender,</if>
            <if test="idCard != null">id_card,</if>
            <if test="college != null">college,</if>
            <if test="major != null">major,</if>
            <if test="className != null">class_name,</if>
            <if test="enrollmentYear != null">enrollment_year,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="statusProfile != null">status_profile,</if>
            <if test="cause != null">cause,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="studentNo != null and studentNo != ''">#{studentNo},</if>
            <if test="realName != null and realName != ''">#{realName},</if>
            <if test="gender != null">#{gender},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="college != null">#{college},</if>
            <if test="major != null">#{major},</if>
            <if test="className != null">#{className},</if>
            <if test="enrollmentYear != null">#{enrollmentYear},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="statusProfile != null">#{statusProfile},</if>
            <if test="cause != null">#{cause},</if>
         </trim>
    </insert>

    <update id="updateBizStudentProfile" parameterType="BizStudentProfile">
        update biz_student_profile
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="studentNo != null and studentNo != ''">student_no = #{studentNo},</if>
            <if test="realName != null and realName != ''">real_name = #{realName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="college != null">college = #{college},</if>
            <if test="major != null">major = #{major},</if>
            <if test="className != null">class_name = #{className},</if>
            <if test="enrollmentYear != null">enrollment_year = #{enrollmentYear},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="statusProfile != null">status_profile = #{statusProfile},</if>
            <if test="cause != null">cause = #{cause},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizStudentProfileById" parameterType="Long">
        delete from biz_student_profile where id = #{id}
    </delete>

    <delete id="deleteBizStudentProfileByIds" parameterType="String">
        delete from biz_student_profile where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>