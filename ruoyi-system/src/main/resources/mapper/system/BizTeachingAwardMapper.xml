            <if test="awardName != null and awardName != ''">award_name = #{awardName},</if>
            <if test="achievementName != null and achievementName != ''">achievement_name = #{achievementName},</if>
            <if test="awardLevel != null">award_level = #{awardLevel},</if>
            <if test="awardDate != null">award_date = #{awardDate},</if>
            <if test="allContributors != null">all_contributors = #{allContributors},</if>
            <if test="issuingAuthority != null">issuing_authority = #{issuingAuthority},</if>
            <if test="awardGrade != null">award_grade = #{awardGrade},</if>
            <if test="certNumber != null">cert_number = #{certNumber},</if>
            <if test="mainAchievement != null">main_achievement = #{mainAchievement},</if>
