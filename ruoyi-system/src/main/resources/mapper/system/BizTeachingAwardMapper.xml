    <sql id="selectBizTeachingAwardVo">
        select id, user_id, award_name, achievement_name, award_level, award_date, all_contributors, issuing_authority, award_grade, cert_number, main_achievement, create_by, create_time, update_by, update_time, remark from biz_teaching_award
    </sql>

    <select id="selectBizTeachingAwardList" parameterType="BizTeachingAward" resultMap="BizTeachingAwardResult">
        <include refid="selectBizTeachingAwardVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="awardName != null  and awardName != ''"> and award_name like concat('%', #{awardName}, '%')</if>
            <if test="achievementName != null  and achievementName != ''"> and achievement_name like concat('%', #{achievementName}, '%')</if>
            <if test="awardLevel != null  and awardLevel != ''"> and award_level = #{awardLevel}</if>
            <if test="awardDate != null "> and award_date = #{awardDate}</if>
            <if test="allContributors != null  and allContributors != ''"> and all_contributors = #{allContributors}</if>
            <if test="issuingAuthority != null  and issuingAuthority != ''"> and issuing_authority = #{issuingAuthority}</if>
            <if test="awardGrade != null  and awardGrade != ''"> and award_grade = #{awardGrade}</if>
            <if test="certNumber != null  and certNumber != ''"> and cert_number = #{certNumber}</if>
            <if test="mainAchievement != null  and mainAchievement != ''"> and main_achievement = #{mainAchievement}</if>
        </where>
    </select>
    
    <select id="selectBizTeachingAwardById" parameterType="Long" resultMap="BizTeachingAwardResult">
        <include refid="selectBizTeachingAwardVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizTeachingAward" parameterType="BizTeachingAward" useGeneratedKeys="true" keyProperty="id">
