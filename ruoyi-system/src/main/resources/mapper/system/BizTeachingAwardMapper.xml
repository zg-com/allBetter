<mapper namespace="com.ruoyi.system.mapper.BizTeachingAwardMapper">
    
    <resultMap type="BizTeachingAward" id="BizTeachingAwardResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="awardName"    column="award_name"    />
