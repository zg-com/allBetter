<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizPaperAuthorMapper">
    
    <resultMap type="BizPaperAuthor" id="BizPaperAuthorResult">
        <result property="id"    column="id"    />
        <result property="paperId"    column="paper_id"    />
        <result property="userId"    column="user_id"    />
        <result property="authorOrder"    column="author_order"    />
        <result property="isCorresponding"    column="is_corresponding"    />
        <result property="contribution"    column="contribution"    />
    </resultMap>

    <sql id="selectBizPaperAuthorVo">
        select id, paper_id, user_id, author_order, is_corresponding, contribution from biz_paper_author
    </sql>

    <select id="selectBizPaperAuthorList" parameterType="BizPaperAuthor" resultMap="BizPaperAuthorResult">
        <include refid="selectBizPaperAuthorVo"/>
        <where>  
            <if test="paperId != null "> and paper_id = #{paperId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="authorOrder != null "> and author_order = #{authorOrder}</if>
            <if test="isCorresponding != null "> and is_corresponding = #{isCorresponding}</if>
            <if test="contribution != null "> and contribution = #{contribution}</if>
        </where>
    </select>
    
    <select id="selectBizPaperAuthorById" parameterType="Long" resultMap="BizPaperAuthorResult">
        <include refid="selectBizPaperAuthorVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizPaperAuthor" parameterType="BizPaperAuthor" useGeneratedKeys="true" keyProperty="id">
        insert into biz_paper_author
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="paperId != null">paper_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="authorOrder != null">author_order,</if>
            <if test="isCorresponding != null">is_corresponding,</if>
            <if test="contribution != null">contribution,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="paperId != null">#{paperId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="authorOrder != null">#{authorOrder},</if>
            <if test="isCorresponding != null">#{isCorresponding},</if>
            <if test="contribution != null">#{contribution},</if>
         </trim>
    </insert>

    <update id="updateBizPaperAuthor" parameterType="BizPaperAuthor">
        update biz_paper_author
        <trim prefix="SET" suffixOverrides=",">
            <if test="paperId != null">paper_id = #{paperId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="authorOrder != null">author_order = #{authorOrder},</if>
            <if test="isCorresponding != null">is_corresponding = #{isCorresponding},</if>
            <if test="contribution != null">contribution = #{contribution},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizPaperAuthorById" parameterType="Long">
        delete from biz_paper_author where id = #{id}
    </delete>

    <delete id="deleteBizPaperAuthorByIds" parameterType="String">
        delete from biz_paper_author where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>